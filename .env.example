# Provedor compatível com OpenAI (OpenAI, Ollama, vLLM)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
MODEL=gpt-5-mini
# modelos de raciocínio gastam o orçamento de saída pensando; "minimal" evita resposta vazia
REASONING_EFFORT=minimal
MAX_OUTPUT_TOKENS=1500

# Busca: ddg (sem chave) ou tavily (requer chave)
SEARCH_PROVIDER=ddg
TAVILY_API_KEY=

# Orçamento por tarefa
MAX_STEPS=18
MAX_TOKENS=180000
MAX_SECONDS=180
MAX_COST_USD=0.35

# Guardas
GUARDS_ENABLED=true
LOOP_REPEAT_LIMIT=3
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_S=120

# MCP (stdio)
MCP_COMMAND=python
MCP_ARGS=-m argus_tools.server
